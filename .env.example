GEMINI_API_KEY=your_key_here
SEMANTIC_SCHOLAR_API_KEY=your_key_here
SERPER_API_KEY=your_key_here
CROSSREF_EMAIL=your_email@example.com

# --- Alibaba Cloud / Qwen (DashScope) -- alternative to Gemini ---
# Set DASHSCOPE_API_KEY (and leave GEMINI_API_KEY unset) to run the sub-agent
# LLM calls (citation claim verification, plagiarism similarity, quality prose
# review, reference parsing) on Qwen instead of Gemini. See services/llm.py.
# DASHSCOPE_API_KEY=your_dashscope_key_here
# PAPERGUARD_DASHSCOPE_MODEL=qwen-plus
# PAPERGUARD_DASHSCOPE_API_BASE=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
# PAPERGUARD_LLM_PROVIDER=auto   # auto | gemini | dashscope

# --- CrewAI crew-level LLM (orchestrator synthesis) -- separately configurable ---
# PAPERGUARD_CREW_MODEL=dashscope/qwen-plus
# PAPERGUARD_CREW_API_BASE=https://dashscope-intl.aliyuncs.com/compatible-mode/v1

# --- Detector model + threshold overrides (optional) ---
# PAPERGUARD_DETECTOR_MODEL=desklib/ai-text-detector-v1.01
# PAPERGUARD_DETECTOR_AI_THRESHOLD=90
# PAPERGUARD_DETECTOR_HUMAN_THRESHOLD=35

# Shared LLM sampling temperature (verdict/synthesis determinism). Default 0.0.
# PAPERGUARD_LLM_TEMPERATURE=0.0
